# Runtime data — never commit. Contains the SQLite DB, keys, and user files.
/data/
*.db
*.db-wal
*.db-shm

# Build output. Only the binary at the repo root, not every file starting with
# "denly-" — a broad glob here silently swallows docs like denly-plan.md.
/dist/
/denly
/denly.exe

# Generated by the Cloudflare Pages build command (cp install.sh site/).
# Committing it would let the published installer drift from the tested one.
/site/install.sh

# Local env / secrets
.env
.env.*
!.env.example

# Wrangler local bindings. Holds a real Resend API key — never commit it.
# The .example file carries placeholders only and is safe to track.
.dev.vars
.dev.vars.*
!.dev.vars.example

# OS cruft
.DS_Store
Thumbs.db

# Wrangler local dev state
/.wrangler/
/node_modules/
